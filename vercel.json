{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "rewrites": [
    {
      "source": "/doc/:path*",
      "destination": "/public/doc/:path*"
    },
    {
      "source": "/image/:path*",
      "destination": "/public/image/:path*"
    },
    {
      "source": "/",
      "destination": "/api/index.php"
    }
  ]
}